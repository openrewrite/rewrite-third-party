    }

    public static IAMInfo getIAMInstanceProfileInfo() {
        String json = getData(EC2_METADATA_ROOT + "/iam/info");
        if (json == null) {
            return null;
        }
        try {
            Map<String, Object> doc = Json.parseObject(json);
            IAMInfo info = new IAMInfo();
            info.code = Json.string(doc, "Code");
            info.message = Json.string(doc, "Message");
            info.lastUpdated = Json.string(doc, "LastUpdated");
            info.instanceProfileArn = Json.string(doc, "InstanceProfileArn");
            info.instanceProfileId = Json.string(doc, "InstanceProfileId");
            return info;
        } catch (RuntimeException e) {
            LOG.log(Level.WARNING, "Unable to parse IAM Instance profile info (" + json + "): " + e.getMessage(), e);
            return null;
        }
    }

    public static InstanceInfo getInstanceInfo() {
        return doGetInstanceInfo(getData(EC2_DYNAMICDATA_ROOT + "instance-identity/document"));
    }

    public static String getInstanceSignature() {
        return fetchData(EC2_DYNAMICDATA_ROOT + "instance-identity/signature");
    }

    public static String getEC2InstanceRegion() {
        String json = getData(EC2_DYNAMICDATA_ROOT + "instance-identity/document");
        if (json == null) {
            return null;
        }
        try {
            return Json.string(Json.parseObject(json), "region");
        } catch (RuntimeException e) {
            LOG.log(Level.WARNING, "Unable to parse EC2 instance info (" + json + ") : " + e.getMessage(), e);
            return null;
        }
    }

    public static Map<String, IAMSecurityCredential> getIAMSecurityCredentials() {
        Map<String, IAMSecurityCredential> credentialsInfoMap = new HashMap<>();
        List<String> credentials = getItems(EC2_METADATA_ROOT + "/iam/security-credentials");
        if (credentials != null) {
            for (String credential : credentials) {
                String json = getData(EC2_METADATA_ROOT + "/iam/security-credentials/" + credential);
                try {
                    Map<String, Object> doc = Json.parseObject(json);
                    IAMSecurityCredential info = new IAMSecurityCredential();
                    info.code = Json.string(doc, "Code");
                    info.message = Json.string(doc, "Message");
                    info.lastUpdated = Json.string(doc, "LastUpdated");
                    info.type = Json.string(doc, "Type");
                    info.accessKeyId = Json.string(doc, "AccessKeyId");
                    info.secretAccessKey = Json.string(doc, "SecretAccessKey");
                    info.token = Json.string(doc, "Token");
                    info.expiration = Json.string(doc, "Expiration");
                    credentialsInfoMap.put(credential, info);
                } catch (RuntimeException e) {
                    LOG.log(Level.WARNING, "Unable to process the credential (" + credential + "). " + e.getMessage(), e);
                }
            }
        }
        return credentialsInfoMap;
    }

    public static Map<String, String> getBlockDeviceMapping() {
        Map<String, String> blockDeviceMapping = new HashMap<>();
        List<String> devices = getItems(EC2_METADATA_ROOT + "/block-device-mapping");
        if (devices != null) {
            for (String device : devices) {
                blockDeviceMapping.put(device, getData(EC2_METADATA_ROOT + "/block-device-mapping/" + device));
            }
        }
        return blockDeviceMapping;
    }

    public static List<NetworkInterface> getNetworkInterfaces() {
        List<NetworkInterface> networkInterfaces = new LinkedList<>();
        List<String> macs = getItems(EC2_METADATA_ROOT + "/network/interfaces/macs/");
        if (macs != null) {
            for (String mac : macs) {
                String key = mac.trim();
                if (key.endsWith("/")) {
                    key = key.substring(0, key.length() - 1);
                }
                networkInterfaces.add(new NetworkInterface(key));
            }
        }
        return networkInterfaces;
    }

    public static String getUserData() {
        return getData(EC2_USERDATA_ROOT);
    }

    public static String getData(String path) {
        return read(path);
    }

    // v2's client retries on its own, so the attempt count is not used
    public static String getData(String path, int tries) {
        return read(path);
    }

    public static List<String> getItems(String path) {
        String response = read(path);
        return response == null ? null : Arrays.asList(response.split("\n"));
    }

    public static List<String> getItems(String path, int tries) {
        return getItems(path);
    }

    public static String getHostAddressForEC2MetadataService() {
        String host = System.getProperty("com.amazonaws.sdk.ec2MetadataServiceEndpointOverride");
        if (host == null) {
            host = System.getenv("AWS_EC2_METADATA_SERVICE_ENDPOINT");
        }
        return host != null ? host : EC2_METADATA_SERVICE_URL;
    }

    static InstanceInfo doGetInstanceInfo(String json) {
        if (json == null) {
            return null;
        }
        try {
            Map<String, Object> doc = Json.parseObject(json);
            for (String required : new String[]{"pendingTime", "instanceType", "imageId", "instanceId", "architecture", "accountId",
                    "kernelId", "region", "version", "availabilityZone", "privateIp"}) {
                if (!doc.containsKey(required)) {
                    throw new IllegalArgumentException("Missing required property '" + required + "'");
                }
            }
            return new InstanceInfo(Json.string(doc, "pendingTime"), Json.string(doc, "instanceType"), Json.string(doc, "imageId"),
                    Json.string(doc, "instanceId"), Json.strings(doc, "billingProducts"), Json.string(doc, "architecture"),
                    Json.string(doc, "accountId"), Json.string(doc, "kernelId"), Json.string(doc, "ramdiskId"),
                    Json.string(doc, "region"), Json.string(doc, "version"), Json.string(doc, "availabilityZone"),
                    Json.string(doc, "privateIp"), Json.strings(doc, "devpayProductCodes"));
        } catch (RuntimeException e) {
            LOG.log(Level.WARNING, "Unable to parse dynamic EC2 instance info (" + json + ") : " + e.getMessage(), e);
            return null;
        }
    }

    private static String read(String path) {
        String host = System.getProperty("com.amazonaws.sdk.ec2MetadataServiceEndpointOverride");
        try (Ec2MetadataClient client = host == null ? Ec2MetadataClient.create() :
                Ec2MetadataClient.builder().endpoint(URI.create(host)).build()) {
            return client.get(path).asString();
        } catch (Exception e) {
            LOG.log(Level.WARNING, "Unable to retrieve the requested metadata (" + path + "). " + e.getMessage(), e);
            return null;
        }
    }

    // A null result is not cached, so a failed lookup is retried on the next call
    private static String fetchData(String path) {
        String cached = CACHE.get(path);
        if (cached != null) {
            return cached;
        }
        String value = getData(path);
        if (value != null) {
            CACHE.put(path, value);
        }
        return value;
    }

