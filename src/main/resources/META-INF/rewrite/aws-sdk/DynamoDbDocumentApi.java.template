    public static class Table {
        private static final long SLEEP_TIME_MILLIS = 5000;

        private final DynamoDbClient client;
        private final String tableName;
        private volatile TableDescription description;

        Table(DynamoDbClient client, String tableName, TableDescription description) {
            this.client = client;
            this.tableName = tableName;
            this.description = description;
        }

        public String getTableName() {
            return tableName;
        }

        public TableDescription getDescription() {
            return description;
        }

        public TableDescription describe() {
            description = client.describeTable(r -> r.tableName(tableName)).table();
            return description;
        }

        public Index getIndex(String indexName) {
            return new Index(this, indexName);
        }

        public TableDescription waitForActive() throws InterruptedException {
            for (; ; ) {
                TableDescription desc = describe();
                if (desc.tableStatus() == TableStatus.ACTIVE) {
                    return desc;
                }
                if (desc.tableStatus() == TableStatus.DELETING) {
                    throw new IllegalArgumentException("Table " + tableName + " is being deleted");
                }
                Thread.sleep(SLEEP_TIME_MILLIS);
            }
        }

        public void waitForDelete() throws InterruptedException {
            try {
                for (; ; ) {
                    describe();
                    Thread.sleep(SLEEP_TIME_MILLIS);
                }
            } catch (ResourceNotFoundException deleted) {
                // the table is gone
            }
        }

        public DeleteTableOutcome delete() {
            return new DeleteTableOutcome(client.deleteTable(r -> r.tableName(tableName)));
        }

