    public static class KeyAttribute {
        private final String name;
        private final Object value;

        public KeyAttribute(String attributeName, Object value) {
            this.name = attributeName;
            this.value = value;
        }

        public String getName() {
            return name;
        }

        public Object getValue() {
            return value;
        }

        @Override
        public String toString() {
            return name + "=" + value;
        }
    }

    public static class PrimaryKey {
        private final Map<String, KeyAttribute> components = new LinkedHashMap<>();

        public PrimaryKey() {
        }

        public PrimaryKey(KeyAttribute... components) {
            addComponents(components);
        }

        public PrimaryKey(String hashKeyName, Object hashKeyValue) {
            addComponent(hashKeyName, hashKeyValue);
        }

        public PrimaryKey(String hashKeyName, Object hashKeyValue, String rangeKeyName, Object rangeKeyValue) {
            addComponent(hashKeyName, hashKeyValue);
            addComponent(rangeKeyName, rangeKeyValue);
        }

        public Collection<KeyAttribute> getComponents() {
            return components.values();
        }

        public Set<String> getComponentNameSet() {
            return components.keySet();
        }

        public boolean hasComponent(String attrName) {
            return components.containsKey(attrName);
        }

        public PrimaryKey addComponents(KeyAttribute... components) {
            if (components != null) {
                for (KeyAttribute component : components) {
                    this.components.put(component.getName(), component);
                }
            }
            return this;
        }

        public PrimaryKey addComponent(String keyAttributeName, Object keyAttributeValue) {
            components.put(keyAttributeName, new KeyAttribute(keyAttributeName, keyAttributeValue));
            return this;
        }

        Map<String, AttributeValue> toAttributeValues() {
            Map<String, AttributeValue> key = new LinkedHashMap<>();
            for (KeyAttribute component : components.values()) {
                key.put(component.getName(), ItemUtils.toAttributeValue(component.getValue()));
            }
            return key;
        }

        @Override
        public String toString() {
            return String.valueOf(components.values());
        }
    }

    public static class Item {
        private final Map<String, Object> attributes = new LinkedHashMap<>();

        public static Item fromMap(Map<String, Object> attributes) {
            if (attributes == null) {
                return null;
            }
            Item item = new Item();
            for (Map.Entry<String, Object> e : attributes.entrySet()) {
                item.with(e.getKey(), e.getValue());
            }
            return item;
        }

        static Item fromAttributeValues(Map<String, AttributeValue> values) {
            return values == null || values.isEmpty() ? null : fromMap(ItemUtils.toSimpleMapValue(values));
        }

        Map<String, AttributeValue> toAttributeValues() {
            return ItemUtils.fromSimpleMap(attributes);
        }

        public Item withPrimaryKey(PrimaryKey primaryKey) {
            for (KeyAttribute component : primaryKey.getComponents()) {
                with(component.getName(), component.getValue());
            }
            return this;
        }

        public Item withPrimaryKey(String hashKeyName, Object hashKeyValue) {
            return with(hashKeyName, hashKeyValue);
        }

        public Item withPrimaryKey(String hashKeyName, Object hashKeyValue, String rangeKeyName, Object rangeKeyValue) {
            return with(hashKeyName, hashKeyValue).with(rangeKeyName, rangeKeyValue);
        }

        public Item withKeyComponents(KeyAttribute... components) {
            for (KeyAttribute component : components) {
                with(component.getName(), component.getValue());
            }
            return this;
        }

        public Item withKeyComponent(String keyAttrName, Object keyAttrValue) {
            return with(keyAttrName, keyAttrValue);
        }

        public Item withString(String attrName, String val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withNumber(String attrName, Number val) {
            attributes.put(attrName, toBigDecimal(val));
            return this;
        }

        public Item withNumber(String attrName, BigDecimal val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withBigInteger(String attrName, BigInteger val) {
            return withNumber(attrName, val);
        }

        public Item withShort(String attrName, short val) {
            return withNumber(attrName, Short.valueOf(val));
        }

        public Item withInt(String attrName, int val) {
            return withNumber(attrName, Integer.valueOf(val));
        }

        public Item withLong(String attrName, long val) {
            return withNumber(attrName, Long.valueOf(val));
        }

        public Item withFloat(String attrName, float val) {
            return withNumber(attrName, Float.valueOf(val));
        }

        public Item withDouble(String attrName, double val) {
            return withNumber(attrName, Double.valueOf(val));
        }

        public Item withBoolean(String attrName, boolean val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withBinary(String attrName, byte[] val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withBinary(String attrName, ByteBuffer val) {
            return withBinary(attrName, ItemUtils.copyAllBytesFrom(val));
        }

        public Item withStringSet(String attrName, Set<String> val) {
            attributes.put(attrName, val == null ? null : new LinkedHashSet<>(val));
            return this;
        }

        public Item withStringSet(String attrName, String... val) {
            return withStringSet(attrName, new LinkedHashSet<>(Arrays.asList(val)));
        }

        public Item withNumberSet(String attrName, Set<? extends Number> val) {
            Set<BigDecimal> set = new LinkedHashSet<>();
            for (Number n : val) {
                set.add(toBigDecimal(n));
            }
            attributes.put(attrName, set);
            return this;
        }

        public Item withNumberSet(String attrName, Number... val) {
            return withNumberSet(attrName, new LinkedHashSet<>(Arrays.asList(val)));
        }

        public Item withBinarySet(String attrName, Set<byte[]> val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withList(String attrName, List<?> val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withList(String attrName, Object... vals) {
            return withList(attrName, Arrays.asList(vals));
        }

        public Item withMap(String attrName, Map<String, ?> val) {
            attributes.put(attrName, val);
            return this;
        }

        public Item withNull(String attrName) {
            attributes.put(attrName, null);
            return this;
        }

        public Item with(String attrName, Object val) {
            if (val instanceof Number && !(val instanceof BigDecimal)) {
                val = toBigDecimal((Number) val);
            } else if (val instanceof ByteBuffer) {
                val = ItemUtils.copyAllBytesFrom((ByteBuffer) val);
            }
            attributes.put(attrName, val);
            return this;
        }

        public Item removeAttribute(String attrName) {
            attributes.remove(attrName);
            return this;
        }

        public boolean hasAttribute(String attrName) {
            return attributes.containsKey(attrName);
        }

        public boolean isPresent(String attrName) {
            return attributes.containsKey(attrName);
        }

        public boolean isNull(String attrName) {
            return attributes.containsKey(attrName) && attributes.get(attrName) == null;
        }

        public Object get(String attrName) {
            return attributes.get(attrName);
        }

        public Class<?> getTypeOf(String attrName) {
            Object val = attributes.get(attrName);
            return val == null ? null : val.getClass();
        }

        public String getString(String attrName) {
            Object val = attributes.get(attrName);
            if (val == null || val instanceof String) {
                return (String) val;
            }
            if (val instanceof BigDecimal) {
                return ((BigDecimal) val).toPlainString();
            }
            if (val instanceof Boolean) {
                return (Boolean) val ? "1" : "0";
            }
            return String.valueOf(val);
        }

        public String getJSON(String attrName) {
            Object val = attributes.get(attrName);
            return val == null ? null : Json.write(val, false);
        }

        public String getJSONPretty(String attrName) {
            Object val = attributes.get(attrName);
            return val == null ? null : Json.write(val, true);
        }

        public Item withJSON(String attrName, String json) {
            attributes.put(attrName, Json.read(json));
            return this;
        }

        public static Item fromJSON(String json) {
            if (json == null) {
                return null;
            }
            @SuppressWarnings("unchecked")
            Map<String, Object> map = (Map<String, Object>) Json.read(json);
            return fromMap(map);
        }

        public String toJSON() {
            return Json.write(attributes, false);
        }

        public String toJSONPretty() {
            return Json.write(attributes, true);
        }

        public BigDecimal getNumber(String attrName) {
            Object val = attributes.get(attrName);
            if (val == null || val instanceof BigDecimal) {
                return (BigDecimal) val;
            }
            if (val instanceof Number) {
                return toBigDecimal((Number) val);
            }
            if (val instanceof Boolean) {
                return (Boolean) val ? BigDecimal.ONE : BigDecimal.ZERO;
            }
            return new BigDecimal(val.toString());
        }

        private BigDecimal requireNumber(String attrName) {
            BigDecimal val = getNumber(attrName);
            if (val == null) {
                throw new NumberFormatException("value of " + attrName + " is null");
            }
            return val;
        }

        public BigInteger getBigInteger(String attrName) {
            BigDecimal val = getNumber(attrName);
            return val == null ? null : val.toBigInteger();
        }

        public short getShort(String attrName) {
            return requireNumber(attrName).shortValue();
        }

        public int getInt(String attrName) {
            return requireNumber(attrName).intValue();
        }

        public long getLong(String attrName) {
            return requireNumber(attrName).longValue();
        }

        public float getFloat(String attrName) {
            return requireNumber(attrName).floatValue();
        }

        public double getDouble(String attrName) {
            return requireNumber(attrName).doubleValue();
        }

        public boolean getBoolean(String attrName) {
            Object val = attributes.get(attrName);
            if (val instanceof Boolean) {
                return (Boolean) val;
            }
            if (val instanceof String) {
                return "1".equals(val) || "true".equalsIgnoreCase((String) val);
            }
            if (val instanceof BigDecimal) {
                return BigDecimal.ONE.compareTo((BigDecimal) val) == 0;
            }
            throw new IncompatibleTypeException("value of " + attrName + " is not a boolean");
        }

        public Boolean getBOOL(String attrName) {
            return (Boolean) attributes.get(attrName);
        }

        public byte[] getBinary(String attrName) {
            Object val = attributes.get(attrName);
            if (val instanceof String) {
                return ((String) val).getBytes(java.nio.charset.StandardCharsets.UTF_8);
            }
            return (byte[]) val;
        }

        public ByteBuffer getByteBuffer(String attrName) {
            byte[] val = getBinary(attrName);
            return val == null ? null : ByteBuffer.wrap(val);
        }

        @SuppressWarnings("unchecked")
        public Set<String> getStringSet(String attrName) {
            Object val = attributes.get(attrName);
            if (val == null) {
                return null;
            }
            Set<String> set = new LinkedHashSet<>();
            for (Object o : (Collection<Object>) val) {
                set.add(o instanceof BigDecimal ? ((BigDecimal) o).toPlainString() : String.valueOf(o));
            }
            return set;
        }

        @SuppressWarnings("unchecked")
        public Set<BigDecimal> getNumberSet(String attrName) {
            Object val = attributes.get(attrName);
            if (val == null) {
                return null;
            }
            Set<BigDecimal> set = new LinkedHashSet<>();
            for (Object o : (Collection<Object>) val) {
                set.add(o instanceof Number ? toBigDecimal((Number) o) : new BigDecimal(o.toString()));
            }
            return set;
        }

        @SuppressWarnings("unchecked")
        public Set<byte[]> getBinarySet(String attrName) {
            return (Set<byte[]>) attributes.get(attrName);
        }

        @SuppressWarnings("unchecked")
        public <T> List<T> getList(String attrName) {
            return (List<T>) attributes.get(attrName);
        }

        @SuppressWarnings("unchecked")
        public <T> Map<String, T> getMap(String attrName) {
            return (Map<String, T>) attributes.get(attrName);
        }

        @SuppressWarnings("unchecked")
        public <T> Map<String, T> getRawMap(String attrName) {
            return (Map<String, T>) attributes.get(attrName);
        }

        public Map<String, Object> asMap() {
            return new LinkedHashMap<>(attributes);
        }

        public Iterable<Map.Entry<String, Object>> attributes() {
            return new ArrayList<>(attributes.entrySet());
        }

        public int numberOfAttributes() {
            return attributes.size();
        }

        @Override
        public boolean equals(Object o) {
            return o instanceof Item && ((Item) o).attributes.equals(attributes);
        }

        @Override
        public int hashCode() {
            return attributes.hashCode();
        }

        @Override
        public String toString() {
            return "{ Item: " + attributes + " }";
        }

        private static BigDecimal toBigDecimal(Number n) {
            if (n == null || n instanceof BigDecimal) {
                return (BigDecimal) n;
            }
            if (n instanceof BigInteger) {
                return new BigDecimal((BigInteger) n);
            }
            return new BigDecimal(n.toString());
        }
    }

    /**
     * v1's legacy conditional parameters. v2's {@code DynamoDbClient} still takes them, so they keep v1's semantics.
     */
    public abstract static class Filter<T extends Filter<T>> {
        private final String attribute;
        private ComparisonOperator op;
        private Object[] values;

        protected Filter(String attrName) {
            Legacy.checkAttrName(attrName);
            this.attribute = attrName;
        }

        public String getAttribute() {
            return attribute;
        }

        public ComparisonOperator getComparisonOperator() {
            return op;
        }

        public Object[] getValues() {
            return values == null ? null : values.clone();
        }

        @SuppressWarnings("unchecked")
        T with(ComparisonOperator op, Object... values) {
            this.op = op;
            if (values.length > 0) {
                this.values = values.clone();
            }
            return (T) this;
        }

        public T eq(Object val) {
            return with(ComparisonOperator.EQ, val);
        }

        public T ne(Object val) {
            return with(ComparisonOperator.NE, val);
        }

        public T exists() {
            return with(ComparisonOperator.NOT_NULL);
        }

        public T notExist() {
            return with(ComparisonOperator.NULL);
        }

        public T contains(Object val) {
            return with(ComparisonOperator.CONTAINS, val);
        }

        public T notContains(Object val) {
            return with(ComparisonOperator.NOT_CONTAINS, val);
        }

        public T beginsWith(String val) {
            return with(ComparisonOperator.BEGINS_WITH, val);
        }

        public T in(Object... values) {
            if (values == null || values.length == 0) {
                throw new IllegalArgumentException("values must not be null or empty.");
            }
            return with(ComparisonOperator.IN, values);
        }

        public T between(Object low, Object hi) {
            return with(ComparisonOperator.BETWEEN, low, hi);
        }

        public T ge(Object val) {
            return with(ComparisonOperator.GE, val);
        }

        public T gt(Object val) {
            return with(ComparisonOperator.GT, val);
        }

        public T le(Object val) {
            return with(ComparisonOperator.LE, val);
        }

        public T lt(Object val) {
            return with(ComparisonOperator.LT, val);
        }
    }

