/**
 * The parts of AWS SDK v1's DynamoDB Document API ({@code com.amazonaws.services.dynamodbv2.document}) that this project uses,
 * with the same names and behaviour, on AWS SDK v2's {@code DynamoDbClient}. Items keep v1's simple values: numbers are
 * {@code BigDecimal}, binaries {@code byte[]}, sets {@code LinkedHashSet}s.
 */
public final class DynamoDbDocumentApi {

    private DynamoDbDocumentApi() {
    }

    public static class DynamoDB {
        private final DynamoDbClient client;

        public DynamoDB(DynamoDbClient client) {
            this.client = client;
        }

        public Table getTable(String tableName) {
            return new Table(client, tableName, null);
        }

        public Table createTable(CreateTableRequest request) {
            CreateTableResponse response = client.createTable(request);
            return new Table(client, request.tableName(), response.tableDescription());
        }

        public Table createTable(String tableName, List<KeySchemaElement> keySchema,
                                 List<AttributeDefinition> attributeDefinitions, ProvisionedThroughput provisionedThroughput) {
            return createTable(CreateTableRequest.builder()
                    .tableName(tableName)
                    .keySchema(keySchema)
                    .attributeDefinitions(attributeDefinitions)
                    .provisionedThroughput(provisionedThroughput)
                    .build());
        }

        public TableCollection<ListTablesResponse> listTables() {
            List<Table> tables = new ArrayList<>();
            for (String name : client.listTablesPaginator().tableNames()) {
                tables.add(getTable(name));
            }
            return new TableCollection<>(tables);
        }

        public BatchWriteItemOutcome batchWriteItem(TableWriteItems... tableWriteItems) {
            Map<String, List<WriteRequest>> requests = new LinkedHashMap<>();
            for (TableWriteItems items : tableWriteItems) {
                requests.computeIfAbsent(items.getTableName(), k -> new ArrayList<>()).addAll(items.writeRequests());
            }
            return batchWriteItemUnprocessed(requests);
        }

        public BatchWriteItemOutcome batchWriteItemUnprocessed(Map<String, ? extends List<WriteRequest>> unprocessedItems) {
            return new BatchWriteItemOutcome(client.batchWriteItem(r -> r.requestItems(new LinkedHashMap<>(unprocessedItems))));
        }

        public void shutdown() {
            client.close();
        }
    }

