    /**
     * The conversions of v1's {@code InternalUtils} from the legacy conditions to their request parameters.
     */
    static final class Legacy {

        private Legacy() {
        }

        static void checkAttrName(String attrName) {
            if (attrName == null || attrName.trim().isEmpty()) {
                throw new IllegalArgumentException("Invalid attribute name");
            }
        }

        static Map<String, ExpectedAttributeValue> expected(Collection<Expected> expected) {
            Map<String, ExpectedAttributeValue> result = new LinkedHashMap<>();
            for (Expected e : expected) {
                ExpectedAttributeValue.Builder eav = ExpectedAttributeValue.builder();
                List<AttributeValue> values = values(e.getValues());
                if (values != null) {
                    eav.attributeValueList(values);
                }
                eav.comparisonOperator(operator(e));
                result.put(e.getAttribute(), eav.build());
            }
            if (expected.size() != result.size()) {
                throw new IllegalArgumentException("duplicates attribute names not allowed in input");
            }
            return Collections.unmodifiableMap(result);
        }

        static Map<String, Condition> conditions(Collection<? extends Filter<?>> filters) {
            Map<String, Condition> result = new LinkedHashMap<>();
            for (Filter<?> f : filters) {
                Condition.Builder condition = Condition.builder();
                List<AttributeValue> values = values(f.getValues());
                if (values != null) {
                    condition.attributeValueList(values);
                }
                condition.comparisonOperator(operator(f));
                result.put(f.getAttribute(), condition.build());
            }
            if (filters.size() != result.size()) {
                throw new IllegalArgumentException("duplicates attribute names not allowed in input");
            }
            return Collections.unmodifiableMap(result);
        }

        static Condition condition(RangeKeyCondition rangeKeyCondition) {
            if (rangeKeyCondition.getKeyCondition() == null) {
                throw new IllegalArgumentException("key condition not specified in range key condition");
            }
            if (rangeKeyCondition.getValues() == null) {
                throw new IllegalArgumentException("key condition values not specified in range key condition");
            }
            return Condition.builder().comparisonOperator(rangeKeyCondition.getKeyCondition().toComparisonOperator())
                    .attributeValueList(values(rangeKeyCondition.getValues())).build();
        }

        static Map<String, AttributeValueUpdate> updates(List<AttributeUpdate> updates) {
            Map<String, AttributeValueUpdate> result = new LinkedHashMap<>();
            for (AttributeUpdate update : updates) {
                AttributeValueUpdate.Builder u = AttributeValueUpdate.builder().action(update.getAction());
                if (update.getValue() != null) {
                    u.value(ItemUtils.toAttributeValue(update.getValue()));
                } else if (update.getAttributeValues() != null) {
                    u.value(ItemUtils.toAttributeValue(update.getAttributeValues()));
                }
                result.put(update.getAttributeName(), u.build());
            }
            return result;
        }

        private static ComparisonOperator operator(Filter<?> f) {
            if (f.getComparisonOperator() == null) {
                throw new IllegalArgumentException("Comparison operator for attribute " + f.getAttribute() + " must be specified");
            }
            return f.getComparisonOperator();
        }

        private static List<AttributeValue> values(Object[] values) {
            if (values == null) {
                return null;
            }
            List<AttributeValue> result = new ArrayList<>();
            for (Object v : values) {
                result.add(ItemUtils.toAttributeValue(v));
            }
            return result;
        }
    }

    /**
     * Writes and reads JSON as v1's Jackson-based {@code Item.toJSON()} and {@code Item.fromJSON(String)} did: binary values as
     * base64 strings, sets as arrays, and numbers read back as {@code BigDecimal}s.
     */
    static final class Json {
        private static final String NL = System.lineSeparator();

        private final String text;
        private int pos;

        private Json(String text) {
            this.text = text;
        }

        static String write(Object value, boolean pretty) {
            StringBuilder sb = new StringBuilder();
            write(sb, value, pretty, 0);
            return sb.toString();
        }

        private static void write(StringBuilder sb, Object value, boolean pretty, int depth) {
            if (value == null) {
                sb.append("null");
            } else if (value instanceof String) {
                string(sb, (String) value);
            } else if (value instanceof Number || value instanceof Boolean) {
                sb.append(value);
            } else if (value instanceof byte[]) {
                string(sb, Base64.getEncoder().encodeToString((byte[]) value));
            } else if (value instanceof ByteBuffer) {
                string(sb, Base64.getEncoder().encodeToString(ItemUtils.copyAllBytesFrom((ByteBuffer) value)));
            } else if (value instanceof Item) {
                write(sb, ((Item) value).asMap(), pretty, depth);
            } else if (value instanceof Map) {
                Map<?, ?> map = (Map<?, ?>) value;
                if (map.isEmpty()) {
                    sb.append(pretty ? "{ }" : "{}");
                    return;
                }
                sb.append('{');
                boolean first = true;
                for (Map.Entry<?, ?> e : map.entrySet()) {
                    sb.append(first ? "" : ",");
                    first = false;
                    if (pretty) {
                        sb.append(NL).append(indent(depth + 1));
                    }
                    string(sb, String.valueOf(e.getKey()));
                    sb.append(pretty ? " : " : ":");
                    write(sb, e.getValue(), pretty, depth + 1);
                }
                if (pretty) {
                    sb.append(NL).append(indent(depth));
                }
                sb.append('}');
            } else if (value instanceof Collection || value instanceof Object[]) {
                Collection<?> c = value instanceof Collection ? (Collection<?>) value : Arrays.asList((Object[]) value);
                if (c.isEmpty()) {
                    sb.append(pretty ? "[ ]" : "[]");
                    return;
                }
                sb.append(pretty ? "[ " : "[");
                boolean first = true;
                for (Object o : c) {
                    sb.append(first ? "" : pretty ? ", " : ",");
                    first = false;
                    write(sb, o, pretty, depth);
                }
                sb.append(pretty ? " ]" : "]");
            } else {
                string(sb, value.toString());
            }
        }

        private static String indent(int depth) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < depth; i++) {
                sb.append("  ");
            }
            return sb.toString();
        }

        private static void string(StringBuilder sb, String s) {
            sb.append('"');
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                switch (c) {
                    case '"':
                        sb.append("\\\"");
                        break;
                    case '\\':
                        sb.append("\\\\");
                        break;
                    case '\n':
                        sb.append("\\n");
                        break;
                    case '\r':
                        sb.append("\\r");
                        break;
                    case '\t':
                        sb.append("\\t");
                        break;
                    case '\b':
                        sb.append("\\b");
                        break;
                    case '\f':
                        sb.append("\\f");
                        break;
                    default:
                        if (c < 0x20) {
                            sb.append(String.format("\\u%04X", (int) c));
                        } else {
                            sb.append(c);
                        }
                }
            }
            sb.append('"');
        }

        static Object read(String text) {
            Json json = new Json(text);
            Object value = json.value();
            json.space();
            if (json.pos != text.length()) {
                throw json.error();
            }
            return value;
        }

        private Object value() {
            space();
            if (pos >= text.length()) {
                throw error();
            }
            char c = text.charAt(pos);
            if (c == '{') {
                pos++;
                Map<String, Object> map = new LinkedHashMap<>();
                space();
                if (peek('}')) {
                    return map;
                }
                do {
                    space();
                    String key = stringValue();
                    space();
                    expect(':');
                    map.put(key, value());
                    space();
                } while (peek(','));
                expect('}');
                return map;
            }
            if (c == '[') {
                pos++;
                List<Object> list = new ArrayList<>();
                space();
                if (peek(']')) {
                    return list;
                }
                do {
                    list.add(value());
                    space();
                } while (peek(','));
                expect(']');
                return list;
            }
            if (c == '"') {
                return stringValue();
            }
            if (text.startsWith("true", pos)) {
                pos += 4;
                return Boolean.TRUE;
            }
            if (text.startsWith("false", pos)) {
                pos += 5;
                return Boolean.FALSE;
            }
            if (text.startsWith("null", pos)) {
                pos += 4;
                return null;
            }
            int start = pos;
            while (pos < text.length() && "+-0123456789.eE".indexOf(text.charAt(pos)) >= 0) {
                pos++;
            }
            if (start == pos) {
                throw error();
            }
            String number = text.substring(start, pos);
            // Jackson read decimals as doubles, which v1 then turned into BigDecimals
            return number.matches("-?[0-9]+") ? new BigDecimal(number) : new BigDecimal(Double.toString(Double.parseDouble(number)));
        }

        private String stringValue() {
            expect('"');
            StringBuilder sb = new StringBuilder();
            while (pos < text.length()) {
                char c = text.charAt(pos++);
                if (c == '"') {
                    return sb.toString();
                }
                if (c != '\\') {
                    sb.append(c);
                    continue;
                }
                char e = text.charAt(pos++);
                switch (e) {
                    case 'n':
                        sb.append('\n');
                        break;
                    case 'r':
                        sb.append('\r');
                        break;
                    case 't':
                        sb.append('\t');
                        break;
                    case 'b':
                        sb.append('\b');
                        break;
                    case 'f':
                        sb.append('\f');
                        break;
                    case 'u':
                        sb.append((char) Integer.parseInt(text.substring(pos, pos + 4), 16));
                        pos += 4;
                        break;
                    default:
                        sb.append(e);
                }
            }
            throw error();
        }

        private void space() {
            while (pos < text.length() && Character.isWhitespace(text.charAt(pos))) {
                pos++;
            }
        }

        private boolean peek(char c) {
            if (pos < text.length() && text.charAt(pos) == c) {
                pos++;
                return true;
            }
            return false;
        }

        private void expect(char c) {
            if (!peek(c)) {
                throw error();
            }
        }

        private IllegalArgumentException error() {
            return new IllegalArgumentException("Invalid JSON at position " + pos + ": " + text);
        }
    }

