        public TableWriteItems(String tableName) {
            this.tableName = tableName;
        }

        public String getTableName() {
            return tableName;
        }

        public TableWriteItems withItemsToPut(Item... itemsToPut) {
            return withItemsToPut(Arrays.asList(itemsToPut));
        }

        public TableWriteItems withItemsToPut(Collection<Item> itemsToPut) {
            this.itemsToPut.clear();
            this.itemsToPut.addAll(itemsToPut);
            return this;
        }

        public TableWriteItems addItemToPut(Item item) {
            itemsToPut.add(item);
            return this;
        }

        public TableWriteItems withPrimaryKeysToDelete(PrimaryKey... primaryKeysToDelete) {
            this.primaryKeysToDelete.clear();
            this.primaryKeysToDelete.addAll(Arrays.asList(primaryKeysToDelete));
            return this;
        }

        public TableWriteItems withHashOnlyKeysToDelete(String hashKeyName, Object... hashKeyValues) {
            this.primaryKeysToDelete.clear();
            for (Object value : hashKeyValues) {
                addHashOnlyPrimaryKeyToDelete(hashKeyName, value);
            }
            return this;
        }

        public TableWriteItems withHashAndRangeKeysToDelete(String hashKeyName, String rangeKeyName,
                                                            Object... alternatingHashAndRangeKeyValues) {
            this.primaryKeysToDelete.clear();
            for (int i = 0; i + 1 < alternatingHashAndRangeKeyValues.length; i += 2) {
                addHashAndRangePrimaryKeyToDelete(hashKeyName, alternatingHashAndRangeKeyValues[i], rangeKeyName,
                        alternatingHashAndRangeKeyValues[i + 1]);
            }
            return this;
        }

        public TableWriteItems addPrimaryKeyToDelete(PrimaryKey primaryKey) {
            primaryKeysToDelete.add(primaryKey);
            return this;
        }

        public TableWriteItems addHashOnlyPrimaryKeyToDelete(String hashKeyName, Object hashKeyValue) {
            return addPrimaryKeyToDelete(new PrimaryKey(hashKeyName, hashKeyValue));
        }

        public TableWriteItems addHashAndRangePrimaryKeyToDelete(String hashKeyName, Object hashKeyValue, String rangeKeyName,
                                                                 Object rangeKeyValue) {
            return addPrimaryKeyToDelete(new PrimaryKey(hashKeyName, hashKeyValue, rangeKeyName, rangeKeyValue));
        }

        public Collection<Item> getItemsToPut() {
            return Collections.unmodifiableList(itemsToPut);
        }

        public Collection<PrimaryKey> getPrimaryKeysToDelete() {
            return Collections.unmodifiableList(primaryKeysToDelete);
        }

        List<WriteRequest> writeRequests() {
            List<WriteRequest> requests = new ArrayList<>();
            for (Item item : itemsToPut) {
                requests.add(WriteRequest.builder().putRequest(PutRequest.builder().item(item.toAttributeValues()).build()).build());
            }
            for (PrimaryKey key : primaryKeysToDelete) {
                requests.add(WriteRequest.builder().deleteRequest(DeleteRequest.builder().key(key.toAttributeValues()).build()).build());
            }
            return requests;
        }
    }

