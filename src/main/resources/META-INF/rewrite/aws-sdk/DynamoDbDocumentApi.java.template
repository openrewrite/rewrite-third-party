    /**
     * Fetches pages lazily as it is iterated, as v1's did, up to the spec's maximum result size.
     */
    public static class ItemCollection<R> implements Iterable<Item> {

        static final class Page<R> {
            final List<Map<String, AttributeValue>> items;
            final Map<String, AttributeValue> lastEvaluatedKey;
            final R outcome;

            Page(List<Map<String, AttributeValue>> items, Map<String, AttributeValue> lastEvaluatedKey, R outcome) {
                this.items = items;
                this.lastEvaluatedKey = lastEvaluatedKey;
                this.outcome = outcome;
            }
        }

        private final Integer maxResultSize;
        private final Function<Map<String, AttributeValue>, Page<R>> fetch;
        private int accumulatedItemCount;
        private R lastLowLevelResult;

        ItemCollection(Integer maxResultSize, Function<Map<String, AttributeValue>, Page<R>> fetch) {
            this.maxResultSize = maxResultSize;
            this.fetch = fetch;
        }

        public int getAccumulatedItemCount() {
            return accumulatedItemCount;
        }

        public R getLastLowLevelResult() {
            return lastLowLevelResult;
        }

        @Override
        public Iterator<Item> iterator() {
            return new Iterator<Item>() {
                private Page<R> page = load(null);
                private int index;
                private int returned;

                private Page<R> load(Map<String, AttributeValue> startKey) {
                    Page<R> p = fetch.apply(startKey);
                    lastLowLevelResult = p.outcome;
                    return p;
                }

                @Override
                public boolean hasNext() {
                    if (maxResultSize != null && returned >= maxResultSize) {
                        return false;
                    }
                    while (index >= page.items.size()) {
                        if (page.lastEvaluatedKey == null || page.lastEvaluatedKey.isEmpty()) {
                            return false;
                        }
                        page = load(page.lastEvaluatedKey);
                        index = 0;
                    }
                    return true;
                }

                @Override
                public Item next() {
                    if (!hasNext()) {
                        throw new NoSuchElementException();
                    }
                    returned++;
                    accumulatedItemCount++;
                    return Item.fromAttributeValues(page.items.get(index++));
                }
            };
        }
    }

