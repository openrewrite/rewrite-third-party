    /**
     * Conversions between v1's simple Java values and attribute values, as v1's {@code ItemUtils} made them.
     */
    public static final class ItemUtils {

        private ItemUtils() {
        }

        public static Item toItem(Map<String, AttributeValue> item) {
            return Item.fromAttributeValues(item);
        }

        public static List<Item> toItemList(List<Map<String, AttributeValue>> items) {
            List<Item> result = new ArrayList<>();
            if (items != null) {
                for (Map<String, AttributeValue> item : items) {
                    result.add(Item.fromAttributeValues(item));
                }
            }
            return result;
        }

        public static Map<String, AttributeValue> toAttributeValues(Item item) {
            return item == null ? null : item.toAttributeValues();
        }

        public static Map<String, AttributeValue> fromSimpleMap(Map<String, ?> map) {
            if (map == null) {
                return null;
            }
            Map<String, AttributeValue> result = new LinkedHashMap<>();
            for (Map.Entry<String, ?> e : map.entrySet()) {
                result.put(e.getKey(), toAttributeValue(e.getValue()));
            }
            return result;
        }

        public static Map<String, AttributeValue> toAttributeValueMap(Map<String, ?> map) {
            return fromSimpleMap(map);
        }

        @SuppressWarnings("unchecked")
        public static AttributeValue toAttributeValue(Object value) {
            if (value == null) {
                return AttributeValue.builder().nul(true).build();
            }
            if (value instanceof AttributeValue) {
                return (AttributeValue) value;
            }
            if (value instanceof String) {
                return AttributeValue.builder().s((String) value).build();
            }
            if (value instanceof Number) {
                return AttributeValue.builder().n(numberString((Number) value)).build();
            }
            if (value instanceof Boolean) {
                return AttributeValue.builder().bool((Boolean) value).build();
            }
            if (value instanceof byte[]) {
                return AttributeValue.builder().b(SdkBytes.fromByteArray((byte[]) value)).build();
            }
            if (value instanceof ByteBuffer) {
                return AttributeValue.builder().b(SdkBytes.fromByteBuffer((ByteBuffer) value)).build();
            }
            if (value instanceof Set) {
                Set<Object> set = (Set<Object>) value;
                if (set.isEmpty()) {
                    throw new IllegalArgumentException("An empty set is not a valid attribute value");
                }
                Object first = set.iterator().next();
                if (first instanceof String) {
                    List<String> ss = new ArrayList<>();
                    for (Object o : set) {
                        ss.add((String) o);
                    }
                    return AttributeValue.builder().ss(ss).build();
                }
                if (first instanceof Number) {
                    List<String> ns = new ArrayList<>();
                    for (Object o : set) {
                        ns.add(numberString((Number) o));
                    }
                    return AttributeValue.builder().ns(ns).build();
                }
                List<SdkBytes> bs = new ArrayList<>();
                for (Object o : set) {
                    bs.add(o instanceof ByteBuffer ? SdkBytes.fromByteBuffer((ByteBuffer) o) : SdkBytes.fromByteArray((byte[]) o));
                }
                return AttributeValue.builder().bs(bs).build();
            }
            if (value instanceof List) {
                List<AttributeValue> l = new ArrayList<>();
                for (Object o : (List<Object>) value) {
                    l.add(toAttributeValue(o));
                }
                return AttributeValue.builder().l(l).build();
            }
            if (value instanceof Map) {
                return AttributeValue.builder().m(fromSimpleMap((Map<String, ?>) value)).build();
            }
            if (value instanceof Item) {
                return AttributeValue.builder().m(((Item) value).toAttributeValues()).build();
            }
            throw new UnsupportedOperationException("value type: " + value.getClass());
        }

        public static Map<String, Object> toSimpleMapValue(Map<String, AttributeValue> values) {
            if (values == null) {
                return null;
            }
            Map<String, Object> result = new LinkedHashMap<>();
            for (Map.Entry<String, AttributeValue> e : values.entrySet()) {
                result.put(e.getKey(), toSimpleValue(e.getValue()));
            }
            return result;
        }

        @SuppressWarnings("unchecked")
        public static <T> T toSimpleValue(AttributeValue value) {
            if (value == null || Boolean.TRUE.equals(value.nul())) {
                return null;
            }
            Object result;
            if (value.s() != null) {
                result = value.s();
            } else if (value.n() != null) {
                result = new BigDecimal(value.n());
            } else if (value.b() != null) {
                result = value.b().asByteArray();
            } else if (value.bool() != null) {
                result = value.bool();
            } else if (value.hasSs()) {
                result = new LinkedHashSet<>(value.ss());
            } else if (value.hasNs()) {
                Set<BigDecimal> ns = new LinkedHashSet<>();
                for (String n : value.ns()) {
                    ns.add(new BigDecimal(n));
                }
                result = ns;
            } else if (value.hasBs()) {
                Set<byte[]> bs = new LinkedHashSet<>();
                for (SdkBytes b : value.bs()) {
                    bs.add(b.asByteArray());
                }
                result = bs;
            } else if (value.hasL()) {
                List<Object> l = new ArrayList<>();
                for (AttributeValue v : value.l()) {
                    l.add(toSimpleValue(v));
                }
                result = l;
            } else if (value.hasM()) {
                result = toSimpleMapValue(value.m());
            } else {
                result = null;
            }
            return (T) result;
        }

        static byte[] copyAllBytesFrom(ByteBuffer buffer) {
            if (buffer == null) {
                return null;
            }
            ByteBuffer copy = buffer.asReadOnlyBuffer();
            copy.rewind();
            byte[] bytes = new byte[copy.remaining()];
            copy.get(bytes);
            return bytes;
        }

        private static String numberString(Number n) {
            if (n instanceof BigDecimal) {
                return ((BigDecimal) n).toPlainString();
            }
            return n.toString();
        }
    }
}
