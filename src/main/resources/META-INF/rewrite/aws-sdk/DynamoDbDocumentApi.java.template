        }

        ItemCollection<QueryOutcome> run(DynamoDbClient client, String tableName, String indexName) {
            Map<String, String> names = nameMap == null ? new LinkedHashMap<>() : new LinkedHashMap<>(nameMap);
            Map<String, Object> values = valueMap == null ? new LinkedHashMap<>() : new LinkedHashMap<>(valueMap);
            String keyCondition = keyConditionExpression;
            boolean legacy = rangeKeyCondition != null || queryFilters != null;
            if (hashKey != null && !legacy) {
                // v1 sent the hash key as a legacy key condition, which cannot be mixed with expressions in v2
                names.put("#v1HashKey", hashKey.getName());
                values.put(":v1HashKey", hashKey.getValue());
                keyCondition = keyCondition == null ? "#v1HashKey = :v1HashKey" : "#v1HashKey = :v1HashKey AND " + keyCondition;
            }
            QueryRequest.Builder request = QueryRequest.builder()
                    .tableName(tableName)
                    .indexName(indexName)
                    .keyConditionExpression(keyCondition)
                    .filterExpression(filterExpression)
                    .projectionExpression(projectionExpression)
                    .scanIndexForward(scanIndexForward)
                    .consistentRead(consistentRead)
                    .limit(maxPageSize);
            if (!names.isEmpty()) {
                request.expressionAttributeNames(names);
            }
            if (!values.isEmpty()) {
                request.expressionAttributeValues(ItemUtils.fromSimpleMap(values));
            }
            if (exclusiveStartKey != null) {
                request.exclusiveStartKey(exclusiveStartKey.toAttributeValues());
            }
            if (legacy) {
                // v1 sends the hash key with a range key condition or query filters as legacy key conditions
                Map<String, Condition> keyConditions = new LinkedHashMap<>();
                if (hashKey != null) {
                    keyConditions.put(hashKey.getName(), Condition.builder().comparisonOperator(ComparisonOperator.EQ)
                            .attributeValueList(ItemUtils.toAttributeValue(hashKey.getValue())).build());
                }
                if (rangeKeyCondition != null) {
                    keyConditions.put(rangeKeyCondition.getAttrName(), Legacy.condition(rangeKeyCondition));
                }
                request.keyConditions(keyConditions).conditionalOperator(conditionalOperator);
                if (queryFilters != null) {
                    request.queryFilter(Legacy.conditions(queryFilters));
                }
            }
            QueryRequest first = request.build();
            return new ItemCollection<>(maxResultSize, startKey -> {
                QueryResponse response = client.query(startKey == null ? first : first.toBuilder().exclusiveStartKey(startKey).build());
                return new ItemCollection.Page<>(response.items(), response.lastEvaluatedKey(), new QueryOutcome(response));
            });
        }
    }

