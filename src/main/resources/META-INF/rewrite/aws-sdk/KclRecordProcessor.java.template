__PACKAGE__import software.amazon.kinesis.lifecycle.ShutdownReason;
import software.amazon.kinesis.lifecycle.events.InitializationInput;
import software.amazon.kinesis.lifecycle.events.LeaseLostInput;
import software.amazon.kinesis.lifecycle.events.ProcessRecordsInput;
import software.amazon.kinesis.lifecycle.events.ShardEndedInput;
import software.amazon.kinesis.lifecycle.events.ShutdownRequestedInput;
import software.amazon.kinesis.processor.RecordProcessorCheckpointer;
import software.amazon.kinesis.processor.ShardRecordProcessor;
import software.amazon.kinesis.retrieval.KinesisClientRecord;

import java.util.List;

/**
 * Kinesis Client Library 1.x's single {@code shutdown(ShutdownInput)} callback on top of KCL 2.x's separate lease-lost,
 * shard-ended and shutdown-requested callbacks. A lost lease (v1's {@code ZOMBIE}) has no checkpointer, as v1's could not
 * be used then either. Generated by the AWS SDK v1 to v2 migration.
 */
public interface KclRecordProcessor extends ShardRecordProcessor {

    void shutdown(ShutdownInput shutdownInput);

    @Override
    default void leaseLost(LeaseLostInput leaseLostInput) {
        shutdown(new ShutdownInput(ShutdownReason.LEASE_LOST, null));
    }

    @Override
    default void shardEnded(ShardEndedInput shardEndedInput) {
        shutdown(new ShutdownInput(ShutdownReason.SHARD_END, shardEndedInput.checkpointer()));
    }

    @Override
    default void shutdownRequested(ShutdownRequestedInput shutdownRequestedInput) {
        if (this instanceof ShutdownNotificationAware) {
            ((ShutdownNotificationAware) this).shutdownRequested(shutdownRequestedInput.checkpointer());
        }
        shutdown(new ShutdownInput(ShutdownReason.REQUESTED, shutdownRequestedInput.checkpointer()));
    }

    /**
     * KCL 1.x's {@code IShutdownNotificationAware}, called before {@code shutdown} on a graceful shutdown.
     */
    interface ShutdownNotificationAware {
        void shutdownRequested(RecordProcessorCheckpointer checkpointer);
    }

    final class ShutdownInput {
        private final ShutdownReason shutdownReason;
        private final RecordProcessorCheckpointer checkpointer;

        public ShutdownInput(ShutdownReason shutdownReason, RecordProcessorCheckpointer checkpointer) {
            this.shutdownReason = shutdownReason;
            this.checkpointer = checkpointer;
        }

        public ShutdownReason getShutdownReason() {
            return shutdownReason;
        }

        public RecordProcessorCheckpointer getCheckpointer() {
            return checkpointer;
        }
    }

    /**
     * KCL 1.x's original {@code IRecordProcessor}, whose callbacks take their arguments directly.
     */
    interface Legacy extends ShardRecordProcessor {

        void initialize(String shardId);

        void processRecords(List<KinesisClientRecord> records, RecordProcessorCheckpointer checkpointer);

        void shutdown(RecordProcessorCheckpointer checkpointer, ShutdownReason reason);

        @Override
        default void initialize(InitializationInput initializationInput) {
            initialize(initializationInput.shardId());
        }

        @Override
        default void processRecords(ProcessRecordsInput processRecordsInput) {
            processRecords(processRecordsInput.records(), processRecordsInput.checkpointer());
        }

        @Override
        default void leaseLost(LeaseLostInput leaseLostInput) {
            shutdown(null, ShutdownReason.LEASE_LOST);
        }

        @Override
        default void shardEnded(ShardEndedInput shardEndedInput) {
            shutdown(shardEndedInput.checkpointer(), ShutdownReason.SHARD_END);
        }

        @Override
        default void shutdownRequested(ShutdownRequestedInput shutdownRequestedInput) {
            if (this instanceof ShutdownNotificationAware) {
                ((ShutdownNotificationAware) this).shutdownRequested(shutdownRequestedInput.checkpointer());
            }
            shutdown(shutdownRequestedInput.checkpointer(), ShutdownReason.REQUESTED);
        }
    }
}
