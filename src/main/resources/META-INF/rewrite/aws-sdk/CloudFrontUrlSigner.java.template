__PACKAGE__import software.amazon.awssdk.services.cloudfront.CloudFrontUtilities;
import software.amazon.awssdk.services.cloudfront.model.CannedSignerRequest;
import software.amazon.awssdk.services.cloudfront.model.CustomSignerRequest;

import java.io.File;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.security.InvalidKeyException;
import java.security.PrivateKey;
import java.security.spec.InvalidKeySpecException;
import java.util.Date;

/**
 * AWS SDK v1's {@code CloudFrontUrlSigner} API, signing with SDK v2's {@code CloudFrontUtilities}. Generated by the AWS SDK
 * v1 to v2 migration.
 */
public final class CloudFrontUrlSigner {

    private CloudFrontUrlSigner() {
    }

    public static String getSignedURLWithCannedPolicy(CloudFrontSignerUtils.Protocol protocol, String distributionDomain,
                                                      File privateKeyFile, String s3ObjectKey, String keyPairId,
                                                      Date dateLessThan) throws InvalidKeySpecException, IOException {
        return getSignedURLWithCannedPolicy(CloudFrontSignerUtils.generateResourcePath(protocol, distributionDomain, s3ObjectKey),
                keyPairId, CloudFrontSignerUtils.loadPrivateKey(privateKeyFile), dateLessThan);
    }

    public static String getSignedURLWithCannedPolicy(String resourceUrlOrPath, String keyPairId, PrivateKey privateKey,
                                                      Date dateLessThan) {
        return CloudFrontUtilities.create().getSignedUrlWithCannedPolicy(CannedSignerRequest.builder()
                .resourceUrl(resourceUrlOrPath)
                .privateKey(privateKey)
                .keyPairId(keyPairId)
                .expirationDate(dateLessThan.toInstant())
                .build()).url();
    }

    public static String getSignedURLWithCustomPolicy(CloudFrontSignerUtils.Protocol protocol, String distributionDomain,
                                                      File privateKeyFile, String s3ObjectKey, String keyPairId,
                                                      Date dateLessThan, Date dateGreaterThan, String ipRange)
            throws InvalidKeySpecException, IOException {
        return getSignedURLWithCustomPolicy(CloudFrontSignerUtils.generateResourcePath(protocol, distributionDomain, s3ObjectKey),
                keyPairId, CloudFrontSignerUtils.loadPrivateKey(privateKeyFile), dateLessThan, dateGreaterThan, ipRange);
    }

    public static String getSignedURLWithCustomPolicy(String resourceUrlOrPath, String keyPairId, PrivateKey privateKey,
                                                      Date dateLessThan, Date dateGreaterThan, String ipRange) {
        CustomSignerRequest.Builder request = CustomSignerRequest.builder()
                .resourceUrl(resourceUrlOrPath)
                .privateKey(privateKey)
                .keyPairId(keyPairId)
                .expirationDate(dateLessThan.toInstant());
        if (dateGreaterThan != null) {
            request.activeDate(dateGreaterThan.toInstant());
        }
        if (ipRange != null) {
            request.ipRange(ipRange);
        }
        return CloudFrontUtilities.create().getSignedUrlWithCustomPolicy(request.build()).url();
    }

    // v2 only signs policies it builds itself, so a caller's own policy is signed as v1 did
    public static String getSignedURLWithCustomPolicy(String resourceUrlOrPath, String keyPairId, PrivateKey privateKey,
                                                      String policy) {
        try {
            byte[] signature = CloudFrontSignerUtils.signWithSha1RSA(policy.getBytes(StandardCharsets.UTF_8), privateKey);
            return resourceUrlOrPath + (resourceUrlOrPath.indexOf('?') >= 0 ? "&" : "?") +
                   "Policy=" + CloudFrontSignerUtils.makeStringUrlSafe(policy) +
                   "&Signature=" + CloudFrontSignerUtils.makeBytesUrlSafe(signature) +
                   "&Key-Pair-Id=" + keyPairId;
        } catch (InvalidKeyException e) {
            throw new IllegalStateException("Couldn't sign url", e);
        }
    }

    public static String buildCustomPolicyForSignedUrl(String resourcePath, Date epochDateLessThan,
                                                       String limitToIpAddressCIDR, Date epochDateGreaterThan) {
        if (epochDateLessThan == null) {
            throw new IllegalArgumentException("epochDateLessThan must be provided to sign CloudFront URLs");
        }
        return CloudFrontSignerUtils.buildCustomPolicy(resourcePath == null ? "*" : resourcePath, epochDateLessThan,
                epochDateGreaterThan, limitToIpAddressCIDR);
    }
}
